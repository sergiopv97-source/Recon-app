# Copie este arquivo para ".env.local" e preencha com os dados do SEU
# projeto Supabase (Project Settings → API no painel do Supabase).
# Veja o passo a passo completo no README.md.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publica-aqui

# Opcional: aviso por e-mail pro treinador quando um check-in gera um
# alerta vermelho. Sem essas duas variáveis, o site funciona normalmente,
# só não manda o e-mail. Veja o passo a passo no README.md.
RESEND_API_KEY=
TRAINER_EMAIL=
